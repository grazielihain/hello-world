# Configurações da API OpenAI
OPENAI_API_KEY=sua_api_key_da_openai

# Configurações da API de Clima
WEATHER_API_KEY=sua_api_key_do_openweathermap

# Configurações do Bot
BOT_NAME=Bot Previsão do Tempo
BOT_DESCRIPTION=Bot especialista em previsão do tempo powered by OpenAI

# Configurações do OpenAI
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1500
OPENAI_TEMPERATURE=0.7

# Configurações de Log
LOG_LEVEL=info